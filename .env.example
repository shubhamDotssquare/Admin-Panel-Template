# Copy to `.env.local` and adjust per environment.
# Only variables prefixed with VITE_ are exposed to the client bundle.

# Branding
VITE_APP_NAME="Admin Panel"
VITE_APP_SHORT_NAME="AP"

# API
VITE_API_BASE_URL="/api"
VITE_API_TIMEOUT="30000"

# Set to "true" once real authentication is wired up; route guards stay inert
# while this is false so the template runs without a backend.
VITE_AUTH_ENABLED="false"

# "light" | "dark" | "system"
VITE_DEFAULT_THEME="system"

# Shown on the Help & Support screen once that module lands.
VITE_SUPPORT_EMAIL=""
